# Database (Neon — personal account, same as ChefMate/ChefCellar, see BACKLOG.md BL-005)
# Three Neon branches, matching the ChefMate/ChefCellar convention: dev (local-only), staging, production
# Local dev — points at the Neon "dev" branch
DATABASE_URL=
# Vercel Preview deployments (staging branch)
DATABASE_URL_STAGING=
# Vercel Production deployments (main branch) — used by the bug-handling scripts, see CLAUDE.md
DATABASE_URL_PRODUCTION=

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Google SSO (NextAuth GoogleProvider — see CLAUDE-CONCEPT.md section 4)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Auth rules — see BACKLOG.md BL-021
# Comma-separated list of email domains auto-approved to USER on first sign-in
AUTO_APPROVED_SSO_DOMAINS=seagullsoftware.com
# Comma-separated list of email addresses auto-approved to ADMIN on first sign-in (bootstrap)
INITIAL_ADMIN_EMAILS=

# Encryption key for per-user Bartender API keys (AES-256-GCM) — see BACKLOG.md BL-032,
# CLAUDE-CONCEPT.md section 7.1. Generate with: openssl rand -base64 32
# Same value must be set in every environment (local, Vercel Preview, Vercel Production) —
# rotating it makes previously-saved Bartender API keys undecryptable.
ENCRYPTION_KEY=

# Email (Resend) — used only by the bug reporter-notification scripts
# (bugs:notify-start / bugs:notify-resolved, see CLAUDE.md "Bug handling").
# If RESEND_API_KEY is unset the scripts still run and mutate the DB, they
# just skip the email. Only needs to be set wherever those scripts are run
# from (a maintainer's machine), not in the Vercel runtime.
RESEND_API_KEY=
# Verified Resend sender. Falls back to Resend's shared onboarding@resend.dev.
RESEND_FROM_EMAIL=

# Shared secret for the two cron tick routes: the workflow run-engine
# (BL-061, CLAUDE-CONCEPT.md 16.5) and the DataCollector heartbeat
# (BL-072, 15.10). An external every-minute scheduler (e.g. cron-job.org)
# calls GET /api/cron/workflow-tick AND, separately, GET
# /api/cron/heartbeat-tick — both with header `x-cron-secret: <this value>`
# (or `Authorization: Bearer <this value>`). One secret, two scheduled calls.
# Set per environment (local, Vercel Preview, Vercel Production).
# Generate with: openssl rand -hex 32
CRON_SECRET=
