# Database (Neon — personal account, same as ChefMate/ChefCellar, see BACKLOG.md BL-005)
# Three Neon branches, matching the ChefMate/ChefCellar convention: dev (local-only), staging, production
# Local dev — points at the Neon "dev" branch
DATABASE_URL=
# Vercel Preview deployments (staging branch)
DATABASE_URL_STAGING=
# Vercel Production deployments (main branch) — used by the bug-handling scripts, see CLAUDE.md
DATABASE_URL_PRODUCTION=

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Google SSO (NextAuth GoogleProvider — see CLAUDE-CONCEPT.md section 4)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Auth rules — see BACKLOG.md BL-021
# Comma-separated list of email domains auto-approved to USER on first sign-in
AUTO_APPROVED_SSO_DOMAINS=seagullsoftware.com
# Comma-separated list of email addresses auto-approved to ADMIN on first sign-in (bootstrap)
INITIAL_ADMIN_EMAILS=

# Encryption key for per-user Bartender API keys (AES-256-GCM) — see BACKLOG.md BL-032,
# CLAUDE-CONCEPT.md section 7.1. Generate with: openssl rand -base64 32
# Same value must be set in every environment (local, Vercel Preview, Vercel Production) —
# rotating it makes previously-saved Bartender API keys undecryptable.
ENCRYPTION_KEY=

# Email (Resend) — used only by the bug reporter-notification scripts
# (bugs:notify-start / bugs:notify-resolved, see CLAUDE.md "Bug handling").
# If RESEND_API_KEY is unset the scripts still run and mutate the DB, they
# just skip the email. Only needs to be set wherever those scripts are run
# from (a maintainer's machine), not in the Vercel runtime.
RESEND_API_KEY=
# Verified Resend sender. Falls back to Resend's shared onboarding@resend.dev.
RESEND_FROM_EMAIL=

# Shared secret for the two cron tick routes: the workflow run-engine
# (BL-061, CLAUDE-CONCEPT.md 16.5) and the DataCollector heartbeat
# (BL-072, 15.10). An external every-minute scheduler (e.g. cron-job.org)
# calls GET /api/cron/workflow-tick AND, separately, GET
# /api/cron/heartbeat-tick — both with header `x-cron-secret: <this value>`
# (or `Authorization: Bearer <this value>`). One secret, two scheduled calls.
# Set per environment (local, Vercel Preview, Vercel Production).
# Generate with: openssl rand -hex 32
CRON_SECRET=

# --- Cron skip-gate (optional, lib/cronClock.ts, CLAUDE-CONCEPT.md §16.5) ---
# Lets an idle /api/cron/tick return without any DB query, so the Neon compute
# can autosuspend while nothing is running. Backed by an Upstash Redis key
# ("cronclock:nextDueAt"). Both must be set for the gate to engage; if either
# is missing the gate is inert and every tick runs in full (pre-gate behaviour).
# (Was Vercel Global Config until 2026-09-09 — its Hobby plan caps writes at
# 100/month and this key is rewritten every real tick, so it ran out.)
#
# Vercel injects these when the Upstash Redis Marketplace integration is
# connected to the project (Storage → Upstash → Connect Project). The exact
# names depend on the env-var prefix chosen at connect time — cronClock.ts
# accepts UPSTASH_REDIS_REST_URL / _TOKEN, KV_REST_API_URL / _TOKEN, or any
# "<prefix>REST_API_URL" (an upstash.io host) + its sibling "<prefix>REST_API_TOKEN"
# (the read/write token, not the *READ_ONLY_TOKEN one). Set a pair locally if
# you want to exercise the gate in dev.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# ...or, as Vercel's default-prefixed connect produces them:
# UPSTASH_REDIS_KV_REST_API_URL=
# UPSTASH_REDIS_KV_REST_API_TOKEN=

# --- Admin "Consumption" tab (optional, lib/resourceUsage.ts, BL-090) ---
# Settings -> Consumption (admin-only): live free-tier usage for the external
# services this app depends on. Each panel is independently optional — missing
# a var for a service just shows "not configured" for that one panel, every
# other panel still works.

# RESEND_USAGE_API_KEY — a SEPARATE Resend API key from RESEND_API_KEY above,
#   with read access (Resend dashboard -> API Keys -> Full access, or the
#   narrowest scope covering "Emails: Read"). Deliberately not the existing
#   key: that one is (correctly) scoped send-only for lib/email.ts, and
#   live-tested 2026-09-14 to 401 on the metrics endpoint this panel needs —
#   widening a send-only key's scope for a read feature isn't the fix.
RESEND_USAGE_API_KEY=

# NEON_API_KEY — a Neon personal API key (console.neon.tech -> Account ->
#   API keys), read-only is enough. Powers the Neon panel (compute hours /
#   data transfer / storage for the current billing period).
NEON_API_KEY=
# NEON_PROJECT_ID — this project's Neon project id (the "collector-simulator"
#   project, not a branch) — console.neon.tech -> project -> Settings -> General.
NEON_PROJECT_ID=

# VERCEL_API_TOKEN — a Vercel access token (Account Settings -> Tokens),
#   read scope is enough. Powers the Vercel panel's one live number
#   (deployments in the last 24h vs. the Hobby plan's 100/day cap) via
#   GET /v6/deployments. Team id + project slug are hardcoded in
#   lib/resourceUsage.ts (non-secret, already visible in every deployment
#   URL) — VERCEL_PROJECT_ID itself is auto-injected by Vercel at runtime,
#   so this token is the only thing to add. Not set locally = "not configured",
#   same fail-open shape as every other panel.
VERCEL_API_TOKEN=

# CRONJOB_ORG_API_KEY — an API key from cron-job.org Console -> Settings -> API
#   (the account running the external /api/cron/tick scheduler). Powers the
#   cron-job.org panel (configured jobs + last-execution health). Note: this
#   key is for READING job status via their API — separate from the scheduled
#   job itself, which calls this app using CRON_SECRET above, not this key.
CRONJOB_ORG_API_KEY=
