// Bartender Track and Trace Simulator — data model.
// See CLAUDE-CONCEPT.md section 4 (auth/user mgmt) and section 3 (bug reporting).
// Devices/Workflows/Serialized Items models are NOT part of this schema yet —
// see BACKLOG.md sections 5-7, still to be settled (BL-003).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
  PENDING
}

enum BugStatus {
  OPEN
  RESOLVED
}

enum WorkflowStatus {
  RUNNING
  STOPPED
}

// Item Feed kind — see CLAUDE-CONCEPT.md section 16.1.
enum ItemFeedKind {
  NEW // mints fresh EPCs via the legacy Serialization API (7.6), hard-capped at 10/firing
  PRESENT // pulls existing items from a site+zone via the Inventory API (7.8)
  FIXED // a literal, explicit EPC/URN list — fires the exact same items every time
}

// PRESENT Item Feed matching (BL-058, revised 2026-08-30).
enum PresentMatchMode {
  GTIN_LIST // match only the GTINs listed in `gtins`
  ALL // match whatever's present in the zone, no GTIN filter — PRESENT only
}

// ─── NextAuth required tables (via @auth/prisma-adapter) ────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── App tables ───────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(PENDING)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Per-user Bartender Track & Trace connection — see CLAUDE-CONCEPT.md
  // section 7.1, BACKLOG.md BL-032. Every role can set these, not just ADMIN.
  bartenderTenantUrl        String?
  bartenderApiKeyCiphertext String? // AES-256-GCM, see lib/crypto.ts — never the plaintext key
  bartenderApiKeyLast4      String? // last 4 chars of the plaintext key, for masked display only

  // Track & Trace login/password — HTTP Basic Auth, used ONLY by the
  // temporary legacy floor-plan map workaround (BL-040/041, see
  // CLAUDE-CONCEPT.md section 7.4). Not used by any other Bartender call.
  bartenderUsername           String?
  bartenderPasswordCiphertext String? // AES-256-GCM, see lib/crypto.ts — never plaintext.
                                       // Deliberately no "last4" field like the API key has —
                                       // don't surface any fragment of a login password in the UI.

  // Overview site selector — see CLAUDE-CONCEPT.md section 14, BACKLOG.md BL-037.
  selectedLocationCode String?

  accounts      Account[]
  sessions      Session[]
  bugReports    BugReport[]
  announcements Announcement[] // authored (BL-075)

  // Per-user workspace ownership (BL-067, CLAUDE-CONCEPT.md section 17).
  ownedDevices   Device[]   @relation("OwnedDevices")
  ownedWorkflows Workflow[] @relation("OwnedWorkflows")
  ownedItemFeeds ItemFeed[] @relation("OwnedItemFeeds")
}

// Admin-authored announcement (BL-075, CLAUDE-CONCEPT.md section 18). Draft
// until published; publishing emails every USER/ADMIN exactly once (the
// emailSentAt guard, same convention as BugReport's notify flow).
model Announcement {
  id        String  @id @default(cuid())
  title     String
  body      String // plain text, rendered with line breaks preserved — no rich-text editor anywhere in this app
  imageData String? // data: URL (base64), capped at 2MB — no image hosting in this app yet (BL-008)

  publishedAt DateTime? // null = draft, admin-tab only; set = live in every user's News feed
  emailSentAt DateTime? // set once the publish email blast finishes — a later edit never re-sends

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([publishedAt])
}

// This app's own simulated read-point fixture — deliberately NOT the same
// thing as Bartender's real DataCollector/Channel concept (location-api-v2,
// see CLAUDE-CONCEPT.md section 7.3/14.2). Powers the Overview location map
// (BL-038) and the Devices-online KPI (BL-039). Redesigned 2026-08-28 (BL-042,
// see CLAUDE-CONCEPT.md section 15.1) to carry the fields a real Bartender
// Collector registration (section 7.5, datacollector-api-v3) needs, so a
// Device is realistic enough to eventually be registered for real — no real
// registration call is ever made by this app, this is field-shape parity only.
model Device {
  id           String  @id @default(cuid())
  collectorId  String? @unique // stable Bartender-facing id — nullable until configured
  name         String // understood as `collectorName` in DataCollector API terms
  type         String // READ_POINT_TYPES from components/ui/ReadPointIcon.tsx — same enum as the API's `readPointType`
  locationCode String // matches a Bartender Location's `code` (location-api-v2) — plain string, not a FK
  positionX    Int? // pixel x on that location's floor plan, nullable if unplaced
  positionY    Int?

  model         String?
  vendor        String?
  configVersion String?

  heartbeatEnabled        Boolean @default(true)
  heartbeatTimeoutSeconds Int     @default(120)
  attributes              Json? // free-form flat scalar key/value map

  // Repeatable Channel list — supersedes the v1 single flattened default
  // Channel (BL-049). Array of { id, type: "PRESENCE" | "DIRECTIONAL",
  // presenceEvent?: "FIRST_SEEN" | "PRESENT" | "LAST_SEEN", direction?: "INBOUND" | "OUTBOUND" }.
  // id is a simple per-Device sequence ("CH1", "CH2", …), not derived from
  // collectorId, so it stays stable if the Collector ID is edited later.
  channels Json?

  // Explicitly set, not derived from collectorId's presence — becomes true
  // only once the config screen's required fields are saved (15.4). Drives
  // the Off state (15.3) when false, alongside publishedAt below.
  configured Boolean @default(false)

  // Null until explicitly published to the platform (BL-051) — see
  // CLAUDE-CONCEPT.md section 15.3. Gates the Off/"Not configured" state
  // alongside `configured`. Since BL-053 (section 15.8) this is set only
  // once a real POST /collectors/register succeeds — never again after the
  // first publish, and never cleared by a later failed resync.
  publishedAt DateTime?

  // Manually set via PATCH /api/devices/[id]/offline (BL-074, 2026-09-02).
  // Null = not manually offline. Only meaningful when configured+published;
  // ignored entirely while the Device is Active (a running Workflow always
  // wins — see lib/deviceState.ts's precedence comment). Not cleared when a
  // Workflow start overrides it, so it's restored once that Workflow stops.
  offlineAt DateTime?

  // Platform sync-health tracking (BL-053, CLAUDE-CONCEPT.md section 15.8).
  // Kept separate from the 4-state Device model (15.3) — a sync failure
  // shows as an in-modal banner, not a 5th colour.
  lastSyncedAt           DateTime? // last successful POST /collectors/register
  lastSyncError          String? // message from the most recent failed register/deregister call; cleared on the next success
  platformReconciliation Json? // the register response's `reconciliation` block, if any — { affectedMappings: [{ channelId, mappingStatus, issue, detail, ... }] }

  // Real heartbeat tracking (BL-072, CLAUDE-CONCEPT.md section 15.10). A
  // scheduled tick PUTs /collectors/{collectorId}/heartbeat every
  // heartbeatTimeoutSeconds/2 for every published, heartbeat-enabled Device.
  lastHeartbeatSentAt DateTime? // stamped on every attempt (success or failure) — drives the due-check
  lastHeartbeatStatus String? // "ONLINE" | "CONFIG_PENDING" | "FAILED", from the most recent attempt
  lastHeartbeatError  String? // message from the most recent FAILED attempt; cleared on the next success

  // A Device relates to a Workflow *through* a Task now (BL-059,
  // CLAUDE-CONCEPT.md 16.6) — the old direct `workflowId` FK is gone.
  task Task?

  // Per-user workspace ownership (BL-067, CLAUDE-CONCEPT.md section 17).
  // `ownerId` is server-derived from the session on every create, never
  // client-supplied. `shared` (admin-toggled only) makes the row read-only-
  // visible to every other user. Nullable only during the 2-step migration;
  // NOT NULL after `require_workspace_owner`.
  ownerId String
  owner   User    @relation("OwnedDevices", fields: [ownerId], references: [id], onDelete: Cascade)
  shared  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([locationCode])
  @@index([ownerId])
}

// A Workflow is a graph of Tasks connected by Flow Links (BL-059,
// CLAUDE-CONCEPT.md section 16). RUNNING/STOPPED drives Device state (15.3);
// the run engine that makes RUNNING actually execute is BL-061 (Part 2).
model Workflow {
  id        String         @id @default(cuid())
  name      String
  status    WorkflowStatus @default(RUNNING)

  // Safety auto-stop for the run engine (BL-061, Part 2). 240 min is a
  // conservative PLACEHOLDER — Luc to confirm/adjust once it's in the UI.
  maxRunDurationMinutes Int?      @default(240)
  runningStartedAt      DateTime? // set when flipped to RUNNING, cleared on STOPPED
  autoStoppedAt         DateTime? // set by the cron job when IT stopped the run (vs a manual stop)

  // Per-user workspace ownership (BL-067, CLAUDE-CONCEPT.md section 17).
  // Task / FeedNode / FeedLink / FlowLink inherit ownership from here via
  // `workflowId` — they get no `ownerId` of their own.
  ownerId String
  owner   User    @relation("OwnedWorkflows", fields: [ownerId], references: [id], onDelete: Cascade)
  shared  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks          Task[]
  feedNodes      FeedNode[]
  feedLinks      FeedLink[]
  flowLinks      FlowLink[]
  inFlightBatches InFlightBatch[]
  simulatedReads SimulatedRead[]

  @@index([ownerId])
}

// Run engine (BL-061, CLAUDE-CONCEPT.md 16.5). A batch of items travelling a
// Flow Link, scheduled to be "read" at (taskId, channelId) at arrivesAt.
model InFlightBatch {
  id          String    @id @default(cuid())
  workflowId  String
  workflow    Workflow  @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  taskId      String
  channelId   String
  items       Json // string[] — EPC hex or URN
  itemGtins   Json? // string|null[] parallel to `items` — per-item GTIN for filter splitting
  gtin        String? // the batch's sole GTIN, or null when mixed (convenience)
  arrivesAt   DateTime
  processedAt DateTime? // set once a tick has generated the read + scheduled next hops

  createdAt DateTime @default(now())

  @@index([workflowId])
  @@index([processedAt, arrivesAt])
}

// Run engine (BL-061). One simulated read event — the plain activity log
// (no live token animation, per Luc 2026-08-30). Local only, never a real
// POST /reads.
model SimulatedRead {
  id         String   @id @default(cuid())
  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  taskId     String
  deviceId   String
  channelId  String
  items      Json // string[]
  itemGtins  Json? // string|null[] parallel to `items`
  gtin       String? // sole GTIN or null when mixed
  occurredAt DateTime @default(now())

  @@index([workflowId, occurredAt])
}

// One Device doing work in one Workflow (CLAUDE-CONCEPT.md 16.2). A Device
// belongs to at most one Task at a time (@unique deviceId).
model Task {
  id         String   @id @default(cuid())
  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  deviceId   String   @unique
  device     Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  name       String? // defaults to the Device's own name if unset
  positionX  Int? // canvas position (Part 2's editor)
  positionY  Int?

  // A Channel's inbound connections are whatever FeedLinks/FlowLinks target
  // it — any number of each, at once (BL-059 revised: "multiple feeds as
  // input of a device"). No exclusive-choice field.
  incomingFeedLinks FeedLink[]
  outgoingFlowLinks FlowLink[] @relation("FlowLinkSource")
  incomingFlowLinks FlowLink[] @relation("FlowLinkTarget")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workflowId])
}

// One placement of a reusable ItemFeed onto one Workflow's canvas. The same
// ItemFeed can have many FeedNodes — same canvas or different Workflows
// (BL-059 revised, CLAUDE-CONCEPT.md 16.2).
model FeedNode {
  id         String   @id @default(cuid())
  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  itemFeedId String
  itemFeed   ItemFeed @relation(fields: [itemFeedId], references: [id], onDelete: Cascade)
  positionX  Int?
  positionY  Int?

  feedLinks FeedLink[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workflowId])
}

// Edge: one FeedNode's output -> one Task's Channel. Firing cadence lives
// here, not on the Channel, since a Channel can have several FeedLinks.
model FeedLink {
  id         String   @id @default(cuid())
  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  feedNodeId String
  feedNode   FeedNode @relation(fields: [feedNodeId], references: [id], onDelete: Cascade)

  targetTaskId    String
  targetTask      Task   @relation(fields: [targetTaskId], references: [id], onDelete: Cascade)
  targetChannelId String // matches an id in the Device's own `channels` Json array

  fireIntervalSeconds Int // how often this edge fires while the Workflow is RUNNING
  lastFiredAt         DateTime? // run engine (BL-061)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workflowId])
  @@index([targetTaskId])
}

// A Channel-to-Channel edge in a Workflow graph (CLAUDE-CONCEPT.md 16.3).
model FlowLink {
  id         String   @id @default(cuid())
  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  sourceTaskId    String
  sourceTask      Task   @relation("FlowLinkSource", fields: [sourceTaskId], references: [id], onDelete: Cascade)
  sourceChannelId String

  targetTaskId    String
  targetTask      Task   @relation("FlowLinkTarget", fields: [targetTaskId], references: [id], onDelete: Cascade)
  targetChannelId String

  delayMinSeconds Int @default(0)
  delayMaxSeconds Int @default(0)

  filterGtins         Json? // string[] — null/empty = no GTIN filter
  filterCategoryCodes Json? // string[]
  isElse              Boolean @default(false) // at most one true per (sourceTaskId, sourceChannelId) — app-enforced

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workflowId])
  @@index([sourceTaskId])
  @@index([targetTaskId])
}

// Item Feed — a named, reusable batch-of-items definition, attachable to any
// Task's Channel input across any Workflow (BL-058, CLAUDE-CONCEPT.md 16.1).
// Kind-specific fields are validated at the API layer (lib/itemFeed.ts), not
// by DB constraints. `taskChannelInputs` back-relation is added in the
// Task/FlowLink migration (BL-059).
model ItemFeed {
  id   String       @id @default(cuid())
  name String
  kind ItemFeedKind

  // NEW: one or more GTINs, required (minting needs a concrete GTIN).
  // PRESENT: used only when presentMatchMode = GTIN_LIST. (BL-058 revised
  // 2026-08-30 — a Feed is no longer limited to a single GTIN.)
  gtins        Json? // string[]
  categoryCode String? // authoring-time bulk-add helper — resolves into `gtins`, not a live reference

  // NEW only. null / "sgtin-96" = default; "sgtin-198" = the longer GS1 EPC
  // encoding (BL-073, 2026-09-01). grai-96/sscc-96/giai-96 are also live on
  // the platform but aren't GTIN-based and don't fit this field — see BL-073's
  // follow-up note.
  gs1Standard String?

  // PRESENT only, default GTIN_LIST. ALL = "match anything present in the
  // zone" — `gtins` is ignored.
  presentMatchMode PresentMatchMode?

  // NEW/PRESENT only. Equal min/max = a fixed count each firing.
  quantityMin Int?
  quantityMax Int?

  // PRESENT only — a specific site+zone (zones aren't globally unique).
  locationCode String?
  zoneCode     String?

  // FIXED only — explicit EPC hex or URN strings, user-entered (string[]).
  fixedItems Json?

  feedNodes FeedNode[] // each is one canvas placement of this Feed

  // Per-user workspace ownership (BL-067, CLAUDE-CONCEPT.md section 17).
  ownerId String
  owner   User    @relation("OwnedItemFeeds", fields: [ownerId], references: [id], onDelete: Cascade)
  shared  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
}

// See CLAUDE-CONCEPT.md section 3 and CLAUDE.md "Bug handling" for the full
// reporting/export/notification process built around this model.
model BugReport {
  id            String    @id @default(cuid())
  // Short human-readable reference (BL-010), distinct from the technical cuid
  // `id` — this is what `npm run bugs:*` scripts take as `<ref>`, what the
  // reporter emails cite, and what BUGS.md / SOLVED-BUGS.md list.
  number        Int       @unique @default(autoincrement())
  title         String
  description   String
  status        BugStatus @default(OPEN)
  screenshotUrl String?
  reporterId    String
  reporter      User      @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  reportedAt    DateTime  @default(now())
  resolvedAt    DateTime?

  // Purely operational timestamps so bugs:notify-start / bugs:notify-resolved
  // (CLAUDE.md "Bug handling") are safe to re-run without emailing the reporter
  // twice. Not shown in the UI.
  notifiedStartAt    DateTime?
  notifiedResolvedAt DateTime?

  @@index([status])
}
