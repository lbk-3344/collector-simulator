// Bartender Track and Trace Simulator — data model.
// See CLAUDE-CONCEPT.md section 4 (auth/user mgmt) and section 3 (bug reporting).
// Devices/Workflows/Serialized Items models are NOT part of this schema yet —
// see BACKLOG.md sections 5-7, still to be settled (BL-003).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
  PENDING
}

enum BugStatus {
  OPEN
  RESOLVED
}

enum DeviceStatus {
  ONLINE
  OFFLINE
}

// ─── NextAuth required tables (via @auth/prisma-adapter) ────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── App tables ───────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(PENDING)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Per-user Bartender Track & Trace connection — see CLAUDE-CONCEPT.md
  // section 7.1, BACKLOG.md BL-032. Every role can set these, not just ADMIN.
  bartenderTenantUrl        String?
  bartenderApiKeyCiphertext String? // AES-256-GCM, see lib/crypto.ts — never the plaintext key
  bartenderApiKeyLast4      String? // last 4 chars of the plaintext key, for masked display only

  // Track & Trace login/password — HTTP Basic Auth, used ONLY by the
  // temporary legacy floor-plan map workaround (BL-040/041, see
  // CLAUDE-CONCEPT.md section 7.4). Not used by any other Bartender call.
  bartenderUsername           String?
  bartenderPasswordCiphertext String? // AES-256-GCM, see lib/crypto.ts — never plaintext.
                                       // Deliberately no "last4" field like the API key has —
                                       // don't surface any fragment of a login password in the UI.

  // Overview site selector — see CLAUDE-CONCEPT.md section 14, BACKLOG.md BL-037.
  selectedLocationCode String?

  accounts   Account[]
  sessions   Session[]
  bugReports BugReport[]
}

// This app's own simulated read-point fixture — deliberately NOT the same
// thing as Bartender's real DataCollector/Channel concept (location-api-v2,
// see CLAUDE-CONCEPT.md section 7.3/14.2). Powers the Overview location map
// (BL-038) and the Devices-online KPI (BL-039).
model Device {
  id           String       @id @default(cuid())
  name         String
  type         String // one of READ_POINT_TYPES from components/ui/ReadPointIcon.tsx (e.g. "PORTAL", "SHELF") — not enforced at the DB level, validated in code
  locationCode String // matches a Bartender Location's `code` (location-api-v2) — plain string, not a FK
  positionX    Int? // pixel x on that location's floor plan, nullable if unplaced
  positionY    Int?
  status       DeviceStatus @default(OFFLINE)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([locationCode])
}

// See CLAUDE-CONCEPT.md section 3 and CLAUDE.md "Bug handling" for the full
// reporting/export/notification process built around this model.
model BugReport {
  id            String    @id @default(cuid())
  title         String
  description   String
  status        BugStatus @default(OPEN)
  screenshotUrl String?
  reporterId    String
  reporter      User      @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  reportedAt    DateTime  @default(now())
  resolvedAt    DateTime?

  @@index([status])
}
